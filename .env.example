# Copy to .env and fill in. Never commit .env.

# Studio Supabase (read summaries, narrator, reference clips directly; no Vercel needed)
SUPABASE_URL=https://tjassbykrroxxhxdynrk.supabase.co
SUPABASE_SERVICE_KEY=

